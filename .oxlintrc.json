{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"ignorePatterns": ["node_modules", "dist/", ".agents/", ".vercel/", "env.d.ts"],
	"plugins": ["react", "node", "typescript", "import", "unicorn", "oxc"],
	"categories": {
		"correctness": "warn"
	},
	"rules": {
		"typescript/consistent-type-imports": ["warn", { "prefer": "type-imports", "fixStyle": "inline-type-imports" }]
	},
	"env": {
		"builtin": true
	},
	"settings": {
		"react": {
			"version": "19.3.1"
		},
		"tailwindcss": {
			"callees": ["cva", "cn"]
		}
	}
}
