		"linkify-react": "^4.4.0",
		"linkifyjs": "^4.4.0",
		"lucide-react": "^1.69.0",
		"motion": "^14.9.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"shadcn": "^4.23.0",
		"tw-animate-css": "^1.4.0",
		"varlock": "^1.24.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.4",
